# URL pública do backend para desenvolvimento. Produção usa /api na Vercel.
# Não coloque senhas ou secrets em VITE_*.
# Vazio em desenvolvimento usa /api via proxy Vite para localhost:8000.
VITE_API_URL=

# Optional: production already defaults to this Railway endpoint.
# Leave empty in development to use the Vite WebSocket proxy.
VITE_WS_URL=
