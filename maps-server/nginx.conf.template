worker_processes 1;
pid /tmp/nginx.pid;
events { worker_connections 256; }

http {
  access_log off;
  proxy_temp_path /tmp/nginx-proxy;
  client_body_temp_path /tmp/nginx-body;
  error_log /dev/stderr warn;

  # Needed because the Nexo upstream is a variable (re-resolved instead of pinned at startup).
  resolver ${RESOLVER} valid=30s ipv6=off;

  # Successful key checks are cached for a minute, so a scraper run does not hit Nexo on every request.
  proxy_cache_path /tmp/nginx-auth keys_zone=nexo_auth:1m max_size=1m inactive=5m;

  server {
    listen ${PORT};

    location = /_health {
      auth_request off;
      default_type text/plain;
      return 200 "ok\n";
    }

    # Asks the Nexo backend whether the Bearer key is valid (2xx = yes, 401 = no).
    location = /_auth {
      internal;
      set $nexo_upstream ${NEXO_API_URL};
      proxy_pass $nexo_upstream/auth/api-keys/validate;
      proxy_method GET;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Host ${NEXO_HOST};
      proxy_set_header Authorization $http_authorization;
      proxy_ssl_server_name on;
      proxy_connect_timeout 5s;
      proxy_read_timeout 10s;

      proxy_cache nexo_auth;
      proxy_cache_key $http_authorization;
      proxy_cache_valid 200 60s;
      proxy_cache_valid 401 10s;
      # Nexo answers with no-store/cookies; cache anyway, this is only the validation result.
      proxy_ignore_headers Cache-Control Expires Set-Cookie;
      proxy_hide_header Set-Cookie;
    }

    location / {
      auth_request /_auth;
      error_page 401 = @denied;
      error_page 500 502 503 504 = @auth_unavailable;

      proxy_pass http://127.0.0.1:8081;
      proxy_set_header Host $host;
      # The Nexo key is only for nginx; do not forward it to the scraper.
      proxy_set_header Authorization "";
      client_max_body_size 10m;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_buffering off;
    }

    location @denied {
      default_type application/json;
      return 401 '{"error":"invalid or missing API key"}';
    }

    location @auth_unavailable {
      default_type application/json;
      return 503 '{"error":"service unavailable"}';
    }
  }
}
