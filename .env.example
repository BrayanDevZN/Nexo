# Copy to .env at the repository root. Never commit real credentials.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/nexo.db
REDIS_URL=redis://localhost:6379/0
ADMIN_NAME=Brayan
# EMAIL/PASSWORD create the administrator; RESEND_KEY sends transactional email.
EMAIL=
PASSWORD=
RESEND_KEY=
# Remetente verificado no Resend; se vazio, usa EMAIL.
RESEND_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=nexo_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
CACHE_TTL_SECONDS=60
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_MAX_WORKERS=2
GLOBAL_RATE_LIMIT=1000
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=./data/uploads
PROFILE_PHOTO_MAX_BYTES=2097152

REDIS_TIMEOUT_SECONDS=3
SQLITE_TIMEOUT_SECONDS=5
EMAIL_TIMEOUT_SECONDS=10
EMAIL_QUEUE_LIMIT=32

EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60

PROFILE_PHOTO_MAX_PIXELS=10000000

# IPs/networks of trusted reverse proxies; empty disables proxy trust.
FORWARDED_ALLOW_IPS=127.0.0.1

# Maximum document upload size (bytes), default 10 MiB
DOCUMENT_MAX_BYTES=10485760

# Realtime + chat (defaults work with existing Redis and /data volume)
CHAT_MEDIA_MAX_BYTES=10485760
WS_CONNECTIONS_PER_USER=3
WS_MESSAGE_LIMIT=60
