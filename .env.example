# Copy to .env at the repository root. Never commit real credentials.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/nexo.db
REDIS_URL=redis://localhost:6379/0
ADMIN_NAME=Brayan
# EMAIL/PASSWORD create the administrator; RESEND_KEY sends transactional email.
EMAIL=
PASSWORD=
RESEND_KEY=
# Optional n8n email fallback after 70 Resend attempts in a UTC calendar month.
URL_EMAIL_N8N=
SECRET_EMAIL_N8N=
# Remetente verificado no Resend; se vazio, usa EMAIL.
RESEND_FROM=noreply@nexoaicompany.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=nexo_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
CACHE_TTL_SECONDS=60
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_MAX_WORKERS=2
GLOBAL_RATE_LIMIT=1000
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIR=./data/uploads
PROFILE_PHOTO_MAX_BYTES=2097152

REDIS_TIMEOUT_SECONDS=3
SQLITE_TIMEOUT_SECONDS=5
EMAIL_TIMEOUT_SECONDS=10
EMAIL_QUEUE_LIMIT=32

EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60

PROFILE_PHOTO_MAX_PIXELS=10000000

# IPs/networks of trusted reverse proxies; empty disables proxy trust.
FORWARDED_ALLOW_IPS=127.0.0.1

# Maximum document upload size (bytes), default 10 MiB
DOCUMENT_MAX_BYTES=10485760

# Realtime + chat (defaults work with existing Redis and /data volume)
CHAT_MEDIA_MAX_BYTES=10485760
WS_CONNECTIONS_PER_USER=3
WS_MESSAGE_LIMIT=60

# Qdrant (vector database) shown in the admin "Bancos de dados" page.
# Empty QDRANT_URL hides it. Server side the key is QDRANT__SERVICE__API_KEY.
QDRANT_URL=https://qdrant-production-3e50f.up.railway.app

# Maps server (Google Maps scraper behind nginx). The key is normally saved from the panel's Maps page
# (stored encrypted). MAPS_API_KEY is only a fallback; use a key from a dev/admin/owner. Never commit it.
MAPS_URL=https://nexo-production-52a1.up.railway.app
MAPS_API_KEY=
QDRANT_API_KEY=

# Videos (HyperFrames): POST /videos and /videos/generate. By default the backend runs the render server itself
# (video-server/, child process inside the same container: nothing to configure, the Docker image has Node, Chrome
# and FFmpeg). Outside Docker run `npm install` in video-server/ and set PRODUCER_HEADLESS_SHELL_PATH.
# Uncomment to use an external render server instead (VIDEO_SECRET = its VIDEO_SERVER_SECRET):
# VIDEO_URL=
# VIDEO_SECRET=
# VIDEO_EMBEDDED=true
# VIDEO_MAX_CONCURRENT_RENDERS=1
# Groq writes the video HTML for POST /videos/generate. Optional: only that route needs it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
