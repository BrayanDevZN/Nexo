# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /app

# Copy the lockfile first so Railway can reuse the dependency layer.
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci

COPY src/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# The template is rendered at container start so Railway's dynamic PORT and
# the backend URL can be configured as service variables.
RUN printf '%s\n' \
  'server {' \
  '    listen ${PORT};' \
  '    listen [::]:${PORT};' \
  '    server_name _;' \
  '    root /usr/share/nginx/html;' \
  '    index index.html;' \
  '    resolver 1.1.1.1 8.8.8.8 ipv6=off valid=300s;' \
  '' \
  '    location /api/ {' \
  '        proxy_pass ${BACKEND_URL}/;' \
  '        proxy_http_version 1.1;' \
  '        proxy_set_header Host $host;' \
  '        proxy_set_header X-Real-IP $remote_addr;' \
  '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
  '        proxy_set_header X-Forwarded-Proto $scheme;' \
  '    }' \
  '' \
  '    location /realtime {' \
  '        proxy_pass ${BACKEND_URL}/realtime;' \
  '        proxy_http_version 1.1;' \
  '        proxy_set_header Upgrade $http_upgrade;' \
  '        proxy_set_header Connection "upgrade";' \
  '        proxy_set_header Host $host;' \
  '        proxy_set_header X-Forwarded-Proto $scheme;' \
  '    }' \
  '' \
  '    location / {' \
  '        try_files $uri $uri/ /index.html;' \
  '    }' \
  '' \
  '    location = /health {' \
  '        access_log off;' \
  '        default_type text/plain;' \
  '        return 200 "ok\\n";' \
  '    }' \
  '}' > /etc/nginx/nexo.conf.template

RUN printf '%s\n' \
  '#!/bin/sh' \
  'set -eu' \
  ': "${PORT:=8080}"' \
  ': "${BACKEND_URL:=https://nexo-production-60a0.up.railway.app}"' \
  'envsubst '\''${PORT} ${BACKEND_URL}'\'' < /etc/nginx/nexo.conf.template > /etc/nginx/conf.d/default.conf' \
  'exec nginx -g "daemon off;"' > /usr/local/bin/start-nginx.sh \
  && chmod +x /usr/local/bin/start-nginx.sh

ENV PORT=8080 \
    BACKEND_URL=https://nexo-production-60a0.up.railway.app

EXPOSE 8080

CMD ["/usr/local/bin/start-nginx.sh"]
